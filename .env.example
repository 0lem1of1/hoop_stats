# Postgres connection string.
# Required at COMPILE time as well as runtime — the sqlx::query! macros are
# checked against a live schema unless you build with SQLX_OFFLINE=true.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hoop_stats

# Secret used to sign JWTs. Generate your own, e.g. `openssl rand -hex 32`.
JWT_SECRET=replace_me_with_a_random_32_byte_hex_string

# Public base URL of this server. Used to build password-reset links,
# so it must match how users actually reach the app.
APP_BASE_URL=http://localhost:3000

# Port to bind. Defaults to 3000 if unset.
PORT=3000

# --- Transactional email (password reset) ---
# The SendGrid send-mail endpoint the server POSTs to.
WEBHOOK_URL=https://api.sendgrid.com/v3/mail/send

# SendGrid credentials. The from-address must be a verified sender in SendGrid.
# Password reset is the only feature that needs these; the rest of the API
# runs fine without them.
SENDGRID_API_KEY=SG.your_api_key_here
SENDGRID_FROM_EMAIL=you@example.com
